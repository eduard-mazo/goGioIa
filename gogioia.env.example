# goGioIa — archivo de configuración de ejemplo.
#
# Cópialo junto al ejecutable como `gogioia.env` (o `.env`) y edítalo. El
# servidor lo carga solo al arrancar; para aplicar cambios hay que reiniciarlo.
#
#   Windows:  copy gogioia.env.example gogioia.env
#   Linux:    cp gogioia.env.example gogioia.env
#
# Precedencia:  flag de arranque > variable de entorno > este archivo > default
#
# Búsqueda del archivo cuando no se pasa --config:
#   1. la ruta de GOGIOIA_CONFIG
#   2. gogioia.env / .env junto al ejecutable
#   3. gogioia.env / .env en el directorio de trabajo
#
# Toda línea es opcional: lo que no aparezca conserva su valor por defecto.
# Formato: CLAVE=valor, # para comentarios, comillas para conservar espacios
# ('literal' sin escapes, "con \n \t"). Acepta CRLF y el BOM del Bloc de notas.
#
# La configuración efectiva, con la procedencia de cada clave, se consulta en
# el dashboard de operaciones → Configuración (GET /api/rag/ops/config).

# ── Servidor web ──────────────────────────────────────────────────────────
WEB_PORT=:8080

# ── Ollama ────────────────────────────────────────────────────────────────
# URL COMPLETA del endpoint de chat: la raíz del host se deriva recortando
# en «/api/», así que debe terminar en /api/chat.
OLLAMA_API=http://127.0.0.1:11434/api/chat
# Modelo de chat general (`ollama list` en el host).
MODEL_NAME=llama3.1:latest

# ── RAG: generación ───────────────────────────────────────────────────────
RAG_MODEL=mistral:latest
RAG_NUM_CTX=8192
RAG_TOP_K=5

# ── RAG: embeddings ───────────────────────────────────────────────────────
# nomic-embed-text produce 768 dimensiones, que es lo que declara la columna
# VECTOR(768, FLOAT32). Cambiarlo por un modelo de otra dimensión exige migrar
# el esquema y re-embeber todo lo ya ingerido.
EMBED_MODEL=nomic-embed-text
EMBED_MAX_TOKENS=2048
EMBED_BATCH=8
# 1 llamada simultánea es lo que entra en una GPU de 2 GiB.
EMBED_CONCURRENCY=1
EMBED_KEEP_ALIVE=10m

# ── RAG: troceado de documentos ───────────────────────────────────────────
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=250

# ── Oracle 23ai (almacén vectorial) ───────────────────────────────────────
# Requiere 23ai: el tipo VECTOR no existe en 19c ni en 21c.
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SID=orcl
ORACLE_USER=useria
ORACLE_PASSWORD=cambiar-esta-password

# ── Dashboard de operaciones ──────────────────────────────────────────────
# Segundos que se cachea la sonda de salud (Oracle, Ollama, modelos).
OPS_HEALTH_TTL=60
